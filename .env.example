# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real credentials.
#
# Client-visible (safe to ship to the browser):
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_APP_URL
# Server-only (must never be exposed to the browser):
#   SUPABASE_SERVICE_ROLE_KEY, GEMINI_API_KEY, AI_MODEL, AI_FALLBACK_MODEL,
#   NVIDIA_API_KEY, NVIDIA_MODEL,
#   UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio -> API key
GEMINI_API_KEY=
# Confirm the model is still listed as Stable at https://ai.google.dev/gemini-api/docs/models
AI_MODEL=gemini-2.5-flash
# Tried once if the primary model fails at the provider level. Optional.
AI_FALLBACK_MODEL=gemini-2.5-flash-lite

# NVIDIA (https://build.nvidia.com) -> OpenAI-compatible endpoint.
# When NVIDIA_API_KEY is set it becomes the primary provider and Google is the
# fallback. Leave empty to use Google only.
# Use the bare model id (for example "z-ai/glm-5.3-flash"), never a "model="
# prefix. Hosted models are reasoning models: chain-of-thought is billed against
# the same token budget as the answer, so the adapter asks for a large budget.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Absolute origin of the deployment. Used for canonical URLs, the QR code,
# and the same-origin check on mutating API routes.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Optional. When absent, rate limiting falls back to a per-instance limiter
# which is best-effort only on serverless hosting. Recommended in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=